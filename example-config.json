{
    "log": {
        "access": "/var/log/xray/access.log", // or any other directory
        "dnsLog": false,
        "error": "/var/log/xray/error.log", // or any other directory
        "loglevel": "warning"
    },
    "api": {
        "tag": "api",
        "services": [
            "HandlerService",
            "LoggerService",
            "StatsService"
        ]
    },
    "inbounds": [
        {
            "tag": "api",
            "listen": "127.0.0.1",
            "port": 8080, 
            "protocol": "tunnel",
            "settings": {
                "address": "127.0.0.1"
            }
        },
        {
            "tag": "your_tag",
            "listen": "0.0.0.0",
            "port": 443, // or any other port
            "protocol": "vless",
            "settings": {
                "clients": [
                    {
                        "email": "your_email",
                        "id": "your_uuid",
                        "flow": ""
                    }
                ],
                "decryption": "none"
            },
            "streamSettings": {
                "network": "xhttp",
                "xhttpSettings": {
                    "path": "/"
                },
                "security": "reality",
                "realitySettings": {
                    "show": false,
                    "target": "github.com:443",
                    "serverNames": [
                        "github.com",
                        "www.github.com"
                    ],
                    "privateKey": "your_private_key",
                    "minClientVer": "",
                    "maxClientVer": "",
                    "maxTimeDiff": 0,
                    "shortIds": [
                        "your_sid"
                    ]
                }
            },
            "sniffing": {
                "enabled": true,
                "destOverride": [
                    "http",
                    "tls",
                    "quic"
                ]
            }
        },
        {
            "tag": "your_tag",
            "listen": "0.0.0.0",
            "port": 4443, // or any other port
            "protocol": "vless",
            "settings": {
                "clients": [
                    {
                        "email": "your_email",
                        "id": "your_uuid",
                        "flow": "xtls-rprx-vision"
                    }
                ],
                "decryption": "none",
                "fallbacks": [
                    {
                        "dest": 80,
                        "xver": 0
                    }
                ]
            },
            "streamSettings": {
                "network": "tcp",
                "security": "reality",
                "realitySettings": {
                    "show": false,
                    "dest": "github.com:443",
                    "xver": 0,
                    "serverNames": [
                        "github.com",
                        "www.github.com"
                    ],
                    "privateKey": "your_private_key",
                    "minClientVer": "",
                    "maxClientVer": "",
                    "maxTimeDiff": 0,
                    "shortIds": [
                        "your_sid"
                    ]
                },
                "tcpSettings": {
                    "alpn": ["http/1.1"]
                }
            },
            "sniffing": {
                "enabled": true,
                "destOverride": [
                    "http",
                    "tls"
                ]
            }
        }
    ],
    "outbounds": [
        {
            "protocol": "freedom",
            "tag": "direct"
        },
        {
            "protocol": "blackhole",
            "tag": "block"
        }
    ],
    "policy": {
        "levels": {
            "0": {
                "handshake": 3,
                "connIdle": 180,
                "statsUserDownlink": true,
                "statsUserUplink": true
            }
        },
        "system": {
            "statsInboundDownlink": true,
            "statsInboundUplink": true,
            "statsOutboundDownlink": false,
            "statsOutboundUplink": false
        }
    },
    "routing": {
            "domainStrategy": "AsIs",
            "rules": [
                {
                    "type": "field",
                    "inboundTag": [
                        "api"
                    ],
                    "outboundTag": "api"
                },
                {
                    "type": "field",
                    "domain": [
                        "geosite:category-ads-all"
                    ],
                    "outboundTag": "block"
                },
                {
                    "type": "field",
                    "ip": [
                        "geoip:cn"
                    ],
                    "outboundTag": "block"
                }
            ]
        },
    "stats": {},
    "metrics": {
        "tag": "metrics_out",
        "listen": "127.0.0.1:11111"
    }
}